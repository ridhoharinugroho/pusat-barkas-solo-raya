# ============================================================
# solosatset - Environment Variables EXAMPLE
# Copy file ini menjadi .env dan isi dengan nilai asli Anda
# File .env.example ini AMAN untuk di-commit ke GitHub
# ============================================================

# Supabase Project URL
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co

# Supabase Anon Key (Public / Safe untuk frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXXX

# ============================================================
# SMTP Gateway Configuration (Backend Serverless Environment Variables)
# Pasang di Vercel Dashboard -> Project Settings -> Environment Variables
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=solosatset.soloraya@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME="Pusat Jual Beli Solo Raya"
SMTP_FROM=solosatset.soloraya@gmail.com
